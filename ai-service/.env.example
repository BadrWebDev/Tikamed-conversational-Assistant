# AI Service Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# OpenAI API (for RAG and embeddings - Cost-effective models)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini  # Most cost-effective: $0.150/1M input, $0.600/1M output
OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # Cheapest embeddings: $0.020/1M tokens

# Gemini API (kept for web search only - free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Store Settings
VECTOR_STORE_PATH=./vector_store
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# CORS (allows Laravel to call this API)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000

# Logging
LOG_LEVEL=INFO